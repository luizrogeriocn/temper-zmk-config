#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NUM_NAV 1
#define FUN 2
#define GAME 3
#define QWERTY 4
#define COMBO_TERM 30
#define TAPPING_TERM 280
#define QUICK_TAP_TERM 175
#define REQUIRE_PRIOR_IDLE 175

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_TERM>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_TERM>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        super_bspc: super_backspace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp LA(BACKSPACE)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;

            mods = <(MOD_LSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;

            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;

            mods = <(MOD_LSFT)>;
        };

        qmrk_excl: qmrk_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;

            mods = <(MOD_LSFT)>;
        };

        slh_morph: slh_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;

            mods = <(MOD_LSFT)>;
        };

        amps_morph: amps_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp PIPE>;

            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 10>;
            layers = <0 4>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <11 1>;
            layers = <0 4>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <12 2>;
            layers = <0 4>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <13 3>;
            layers = <0 4>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <10 20>;
            layers = <0 4>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <11 21>;
            layers = <0 4>;
        };

        ampersand {
            bindings = <&amps_morph>;
            key-positions = <22 12>;
            layers = <0 4>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <13 23>;
            layers = <0 4>;
        };

        Lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <14 4>;
            layers = <0 4>;
        };

        Lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <24 14>;
            layers = <0 4>;
        };

        Rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <15 5>;
            layers = <0 4>;
        };

        Rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <25 15>;
            layers = <0 4>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <19 29>;
            layers = <0 4>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <26 16>;
            layers = <0 4>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <28 18>;
            layers = <0 4>;
        };

        slash_morph {
            bindings = <&slh_morph>;
            key-positions = <8 18>;
            layers = <0 4>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <16 6>;
            layers = <0 4>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <17 7>;
            layers = <0 4>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <27 17>;
            layers = <0 4>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <9 19>;
            layers = <0 4>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <21 22>;
            layers = <0 4>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <27 26>;
            layers = <0 4>;
        };

        backspace {
            bindings = <&bspc_del>;
            key-positions = <28 27>;
            layers = <0 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
  &kp Q         &kp W        &kp F        &kp P         &kp B               &kp J        &kp L         &kp U        &kp Y        &kp APOS
  &hml LCTRL A  &hml LALT R  &hml LGUI S  &hml LSHFT T  &kp G               &kp M        &hmr LSHFT N  &hmr LGUI E  &hmr LALT I  &hmr LCTRL O
  &kp Z         &kp X        &kp C        &kp D         &kp V               &kp K        &kp H         &comma_semi  &dot_colon   &qmrk_excl
                             &kp ESCAPE   &kp SPACE     &kp LEFT_COMMAND    &smart_shft  &mo 1         &mo 2
            >;
        };

        num_nav_layer {
            display-name = "num/nav";
            bindings = <
  &kp PG_UP   &kp HOME  &kp UP_ARROW    &kp END    &trans    &trans  &kp N7  &kp N8  &kp N9  &trans
  &kp PG_DN   &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &trans    &trans  &kp N4  &kp N5  &kp N6  &kp N0
  &kp ESCAPE  &kp TAB   &kp ENTER       &bspc_del  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans
                        &trans          &trans     &trans    &trans  &trans  &trans
            >;
        };

        fun_layer {
            display-name = "fun";
            bindings = <
  &kp PRINTSCREEN  &kp K_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &out OUT_USB    &to 3   &kp F9  &kp F10  &kp F11  &kp F12
  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &to 0   &kp F5  &kp F6   &kp F7   &kp F8
  &bt BT_CLR       &kp C_PREV    &kp C_PP      &kp C_NEXT    &out OUT_BLE    &to 4   &kp F1  &kp F2   &kp F3   &kp F4
                                 &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        game_layer {
            display-name = "game";
            bindings = <
  &kp TAB    &kp Q  &kp W    &kp E   &kp R        &trans  &trans  &trans  &trans  &trans
  &kp LSHFT  &kp A  &kp S    &kp D   &kp F        &trans  &trans  &trans  &trans  &trans
  &kp LCTRL  &kp Z  &kp X    &kp C   &kp V        &trans  &trans  &trans  &trans  &trans
                    &kp ESC  &trans  &kp SPACE    &trans  &trans  &to 0
            >;
        };

        qwerty_layer {
            display-name = "qwerty";
            bindings = <
  &kp Q         &kp W        &kp E        &kp R         &kp T    &kp Y        &kp U         &kp I        &kp O        &kp P
  &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G    &kp H        &hmr LSHFT J  &hmr LGUI K  &hmr LALT L  &hmr LCTRL SINGLE_QUOTE
  &kp Z         &kp X        &kp C        &kp V         &kp B    &kp N        &kp M         &comma_semi  &dot_colon   &qmrk_excl
                             &kp ESCAPE   &kp SPACE     &to 0    &smart_shft  &mo 1         &mo 2
            >;
        };
    };
};

&mt {
    tapping-term-ms = <TAPPING_TERM>;
    flavor = "tap-preferred";
    quick-tap-ms = <QUICK_TAP_TERM>;
    require-prior-idle-ms = <REQUIRE_PRIOR_IDLE>;
};

&lt {
    tapping-term-ms = <TAPPING_TERM>;
    flavor = "tap-preferred";
    quick-tap-ms = <QUICK_TAP_TERM>;
};
